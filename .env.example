# Copy to .env.local and fill in.
SITE_URL=http://localhost:3000

# Admin panel at /admin (password 8+ chars, secret 32+ chars: e.g. `openssl rand -hex 32`)
ADMIN_PASSWORD=
SESSION_SECRET=

# Where new-order and bank-slip notifications go
ADMIN_EMAIL=

# Email sending (any SMTP provider: Gmail app password, Zoho, Brevo, Amazon SES…)
# Leave SMTP_HOST empty to save emails to data/outbox/ instead of sending.
MAIL_FROM="Rail <orders@yourdomain.lk>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
